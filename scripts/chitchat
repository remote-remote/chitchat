#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12,<3.13"
# dependencies = [
#   "mlx-audio==0.6.6",
#   "soundfile==0.14.0",
# ]
# ///
"""Speak Claude Code replies aloud in a voice cloned locally with Chatterbox Turbo.

Speech is enabled per Claude Code session. Each session speaks its messages in
order, one at a time. Sessions that speak at the same time take turns. A new
prompt silences whatever its session had left to say.

One speech server speaks for every session. Hooks write each message to a queue
file for its session and ring the server over a Unix socket in the state
directory; the first ring with no server listening starts one. The server loads
the model once, prepares each voice the first time it is asked for, and exits
after $CHITCHAT_IDLE_SECONDS (default 600) with nothing queued. Queue files stay
on disk until spoken, so a server that crashes leaves them for the next. Each
request carries the plugin's version, and a server older than the client
finishes what it is saying and exits, leaving the client to start the newer one.

A voice is a WAV sample in $XDG_DATA_HOME/chitchat/voices, named for its
file: voices/data.wav is the voice "data". Chatterbox needs more than 5 seconds
and uses only the first 15. $CHITCHAT_VOICE names the default voice, and
$CHITCHAT_SPEED sets the default rate.

While any session speaks, a running Spotify is lowered to $CHITCHAT_DUCK percent
(default 30), and restored once nothing is left to speak; CHITCHAT_DUCK=off
leaves Spotify alone.

Ordinary speech plays only while its session's tmux pane is focused, and waits
in the queue otherwise, playing once the session is focused again. Text in
<announce> tags speaks right away regardless, and so does text written before a
tool call, outside tagged mode, as the call starts. CHITCHAT_FOCUS=off speaks
everything, focused or not.

Speech that plays while its session is not focused starts with the session's
name. The name is the tmux window's, with a leading fm- dropped and dashes read as
spaces, unless `chitchat name` sets one.

In a Claude Code session, /chitchat runs these without a model turn: /chitchat
alone toggles speech, and /chitchat COMMAND runs on, off, toggle, status, voice,
speed, name, stop, or server. An agent runs the script directly.

  chitchat on|off|toggle|status   enable or disable speech for this session
  chitchat on tagged              speak only text in <speak> or <announce> tags, for an agent the
                                  listener supervises rather than reads along with
  chitchat voice [NAME]           list voices, or choose this session's voice
  chitchat speed [RATE]           show or set this session's playback rate
  chitchat name [NAME|--clear]    show or set the name said before this session's speech
                                  while it is not focused; --clear goes back to the window name
  chitchat stop                   stop this session's speech; outside a session, all
  chitchat server                 show the speech server's state, without starting one
  chitchat hook                   Stop hook: speak the last reply if enabled
  chitchat pretool                speak text written before a tool call, given as a JSON list
                                  on stdin by the hooks module as the call starts, focused or not
  chitchat prompt                 UserPromptSubmit hook: ask for speakable replies
  chitchat end                    SessionEnd hook: forget the session
  chitchat say [SESSION]          speak text read from stdin, focused or not
  chitchat serve                  the speech server; the first message with none listening starts it
"""

import fcntl
import json
import os
import queue
import re
import select
import socket
import subprocess
import sys
import tempfile
import threading
import time
import traceback
from dataclasses import dataclass
from pathlib import Path

MODEL = "mlx-community/chatterbox-turbo-fp16"
DEFAULT_SPEED = os.environ.get("CHITCHAT_SPEED", "1.1")

DEFAULT_VOICE = os.environ.get("CHITCHAT_VOICE", "default")
DUCK_LEVEL = os.environ.get("CHITCHAT_DUCK", "30")
FOCUS_GATE = os.environ.get("CHITCHAT_FOCUS", "on").strip().lower() != "off"
try:
    IDLE_SECONDS = max(float(os.environ.get("CHITCHAT_IDLE_SECONDS", "600")), 0.0)
except ValueError:
    IDLE_SECONDS = 600.0

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "chitchat"
VOICES = DATA / "voices"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "chitchat"
ENABLED = STATE / "sessions"
CHOSEN = STATE / "chosen-voices"
SPEEDS = STATE / "speeds"
NAMES = STATE / "names"
LOGS = STATE / "logs"
QUEUES = STATE / "queues"
OFFSETS = STATE / "offsets"
PANES = STATE / "panes"
SOCKET = STATE / "server.sock"
# Held by the server listening on SOCKET, so only one listens.
LISTEN_LOCK = STATE / "listen.lock"
# Held by the server that plays audio and sets Spotify's volume. A server that
# replaces an older one waits for it while the older one finishes what it is saying.
AUDIO_LOCK = STATE / "audio.lock"
# Held by a client while it starts a server, so sessions ringing at once start one.
START_LOCK = STATE / "start.lock"
# Spotify's volume from before speech lowered it, kept until it is restored, so a
# server that is killed or crashes is restored later.
DUCKED = STATE / "ducked"
PLUGIN = Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json"
# Keys in a session's offsets; real keys are paths. SPOKEN is the last reply the Stop
# hook spoke, and SAID the texts pretool spoke this turn.
SPOKEN = "spoken"
SAID = "said"

VOICE_MODE = """\
Voice mode is on: your whole reply is also read aloud by text-to-speech while the \
listener reads along, so write one reply that works both ways. Code blocks, tables, URLs, \
and inline code that looks like a path or command are skipped when spoken. Right before a \
code block or table, write one plain sentence saying what it shows, the way an engineer \
would point at it, so the listener hears that while reading it. Don't let a path or \
identifier in inline code carry a sentence's meaning alone, and write numbers so they \
read naturally. Speech plays only while the listener is looking at this session, and \
waits for them to come back otherwise. For the rare update they should hear right away \
from another session, such as a merge, a failure, or a decision waiting on them, wrap \
one or two short sentences in <announce>...</announce>; they are read once."""

VOICE_TAGGED = """\
Speech is on in tagged mode: only text inside <speak>...</speak> is read aloud, and \
everything else stays silent. Most replies need no tags. Wrap only an important update \
in them, such as a finished milestone, a failure, a blocker, or a decision that is \
needed, in one or two short plain sentences with numbers written so they read naturally. \
Spoken text plays only while the listener is looking at this session, and waits \
for them to come back otherwise. Use <announce>...</announce> instead, rarely, for an \
update they should hear right away even while looking at another session. The tags are \
hidden on screen."""

# A tag still open at the end is a reply that is streaming in.
VOICE_TAG = re.compile(r"<(speak|announce)>(.*?)(?:</\1>|\Z)", re.S | re.I)
ANNOUNCE_TAG = re.compile(r"</?announce>", re.I)
ANNOUNCEMENT = re.compile(r"<announce>.*?(?:</announce>|\Z)", re.S | re.I)
# How often the server checks whether a session holding speech is focused again.
POLL_SECONDS = 0.5
# How often the server checks whether it has been idle long enough to exit.
IDLE_CHECK_SECONDS = 1.0
# How long a client waits for a server it started to listen.
STARTUP_SECONDS = 5.0


def plugin_version() -> str:
    try:
        return json.loads(PLUGIN.read_text())["version"]
    except (OSError, ValueError, KeyError):
        return "0"


VERSION = plugin_version()


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    for d in (ENABLED, CHOSEN, SPEEDS, NAMES, LOGS, QUEUES, OFFSETS, PANES, VOICES):
        d.mkdir(parents=True, exist_ok=True)
    if cmd != "serve" and DUCKED.exists():
        restore_unowned()
    if cmd in ("on", "off", "toggle", "status"):
        toggle(cmd, current_session(), sys.argv[2] if len(sys.argv) > 2 else "")
    elif cmd == "voice":
        choose_voice(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "speed":
        choose_speed(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "name":
        choose_name(" ".join(sys.argv[2:]).strip() or None)
    elif cmd == "stop":
        stop(os.environ.get("CLAUDE_CODE_SESSION_ID") or None)
    elif cmd == "hook":
        hook(json.load(sys.stdin))
    elif cmd == "pretool":
        pretool(os.environ.get("CLAUDE_CODE_SESSION_ID"), json.load(sys.stdin))
    elif cmd == "prompt":
        event = json.load(sys.stdin)
        session = event.get("session_id")
        if enabled(session):
            # A background task notification arrives as a prompt too, but only a
            # prompt the user typed should cut off speech.
            if not event.get("prompt", "").lstrip().startswith("<task-notification>"):
                stop(session)
            remember_pane(session)
            skip_to_end(session, event.get("transcript_path"))
            # A turn cut off before its Stop hook leaves what pretool() said behind.
            with offsets(session) as saved:
                saved.pop(SAID, None)
            print(VOICE_TAGGED if tagged(session) else VOICE_MODE)
    elif cmd == "end":
        session = json.load(sys.stdin).get("session_id")
        if session:
            (ENABLED / session).unlink(missing_ok=True)
            (OFFSETS / session).unlink(missing_ok=True)
            (CHOSEN / session).unlink(missing_ok=True)
            (SPEEDS / session).unlink(missing_ok=True)
            (NAMES / session).unlink(missing_ok=True)
            (PANES / session).unlink(missing_ok=True)
            stop(session)
    elif cmd == "say":
        text = sys.stdin.read()
        enqueue(sys.argv[2] if len(sys.argv) > 2 else "manual", text, text, "")
    elif cmd == "serve":
        serve()
    elif cmd == "server":
        print(server_status(send({"op": "status"})))
    else:
        sys.exit(__doc__)


def current_session() -> str:
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session:
        sys.exit("chitchat: run inside a Claude Code session, as `/chitchat on`")
    return session


def enabled(session: str | None) -> bool:
    return bool(session) and (ENABLED / session).exists()


def tagged(session: str | None) -> bool:
    return enabled(session) and (ENABLED / session).read_text().strip() == "tagged"


def toggle(cmd: str, session: str, mode: str) -> None:
    if mode not in ("", "tagged"):
        sys.exit(f"chitchat: unknown mode {mode!r}; the only mode is tagged")
    if cmd == "toggle":
        cmd = "off" if enabled(session) else "on"
    if cmd == "on":
        (ENABLED / session).write_text(mode)
        remember_pane(session)
    elif cmd == "off":
        (ENABLED / session).unlink(missing_ok=True)
        stop(session)
    if not enabled(session):
        print("speech off")
    else:
        print("speech on, tagged" if tagged(session) else "speech on")


def voice(session: str) -> str:
    chosen = CHOSEN / session
    return chosen.read_text().strip() if chosen.exists() else DEFAULT_VOICE


def choose_voice(name: str | None) -> None:
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if name is None:
        current = voice(session) if session else DEFAULT_VOICE
        for v in sorted(f.stem for f in VOICES.glob("*.wav")):
            print(f"{'*' if v == current else ' '} {v}")
        return
    if not (VOICES / f"{name}.wav").exists():
        sys.exit(f"chitchat: no voice {name!r} in {VOICES}")
    (CHOSEN / current_session()).write_text(name)
    print(f"voice {name}")


def speed(session: str) -> str:
    chosen = SPEEDS / session
    return chosen.read_text().strip() if chosen.exists() else DEFAULT_SPEED


def choose_speed(rate: str | None) -> None:
    session = current_session()
    if rate is not None:
        try:
            ok = 0.5 <= float(rate) <= 2
        except ValueError:
            ok = False
        if not ok:
            sys.exit("chitchat: speed is a rate from 0.5 to 2")
        (SPEEDS / session).write_text(rate)
    print(f"speed {speed(session)}")


def name(session: str, window: str) -> str:
    """The name said before the session's unfocused speech: the one chosen, or else
    the window's. Worker windows are named fm-<task-id>."""
    chosen = NAMES / session
    if chosen.exists():
        return chosen.read_text().strip()
    return window.removeprefix("fm-").replace("-", " ").strip()


def choose_name(new: str | None) -> None:
    session = current_session()
    if new == "--clear":
        (NAMES / session).unlink(missing_ok=True)
    elif new is not None:
        (NAMES / session).write_text(new)
    pane = os.environ.get("TMUX_PANE")
    window = tmux_pane(pane, tmux_socket()) if pane else None
    current = name(session, read_pane(window).window if window else "")
    print(f"name {current}" if current else "no name; outside tmux, nothing is said first")


def hook(event: dict) -> None:
    session = event.get("session_id")
    if not enabled(session):
        return
    transcript = event.get("transcript_path")
    text = event.get("last_assistant_message") or last_reply(transcript) or ""
    with offsets(session) as saved:
        said = saved.pop(SAID, [])
    # Text written before a tool call was spoken by pretool() as the call started. Any
    # left is text the hooks module did not see, spoken late rather than not at all.
    pending = [t for t in new_texts(session, transcript) if t.strip() not in text and t.strip() not in said]
    # The final reply is spoken from the event, so a later Stop hook must not speak it again.
    # Skipping to the end is not enough: the reply can reach the transcript after this
    # hook runs, and a ! command fires no prompt hook to skip past it later.
    skip_to_end(session, transcript)
    with offsets(session) as saved:
        saved[SPOKEN] = text
    remember_pane(session)
    enqueue(session, *pre_tool("\n".join(pending), tagged(session)))
    # A turn whose last message has no text falls back to an earlier one, which can be
    # text pretool() already spoke.
    if text.strip() not in said:
        enqueue(session, *speakable(text, tagged(session)))


def pretool(session: str | None, texts: list[str]) -> None:
    """Speak text the hooks module read from a response as one of its tool calls began,
    and note it, so the Stop hook does not speak it again from the transcript."""
    if not enabled(session):
        return
    with offsets(session) as saved:
        saved[SAID] = [*saved.get(SAID, []), *(t.strip() for t in texts)]
    remember_pane(session)
    enqueue(session, *pre_tool("\n".join(texts), tagged(session)))


def pre_tool(md: str, tagged_only: bool) -> tuple[str, str, str]:
    """What to say for text written before a tool call. Outside tagged mode it is
    all an announcement, spoken right away whether the session is focused or not."""
    if tagged_only:
        return speakable(md, True)
    text = speakable(md)[0]
    return text, text, ""


def new_texts(session: str, transcript_path: str | None) -> list[str]:
    """Assistant text added to the transcript since this session last read it.

    The offset is kept per transcript path, since a subagent's tool calls may
    report its own transcript. With no offset yet, nothing is read, so turning
    speech on mid-session does not replay the history."""
    if not transcript_path:
        return []
    with offsets(session) as saved:
        start = saved.get(transcript_path)
        with open(transcript_path, "rb") as f:
            if start is None or start > os.fstat(f.fileno()).st_size:
                saved[transcript_path] = f.seek(0, os.SEEK_END)
                return []
            f.seek(start)
            data = f.read()
        # A line still being written is left for the next read.
        end = data.rfind(b"\n") + 1
        saved[transcript_path] = start + end
        spoken = saved.get(SPOKEN, "")
    found = []
    for line in data[:end].splitlines():
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("type") == "assistant" and not entry.get("isSidechain"):
            found += [t for t in texts(entry["message"]) if t.strip() not in spoken]
    return found


def skip_to_end(session: str, transcript_path: str | None) -> None:
    if not transcript_path:
        return
    with offsets(session) as saved:
        try:
            saved[transcript_path] = os.path.getsize(transcript_path)
        except FileNotFoundError:
            pass


class offsets:
    """The session's transcript offsets, read and written under a lock, since
    parallel tool calls run their hooks at the same time."""

    def __init__(self, session: str):
        self.path = OFFSETS / session

    def __enter__(self) -> dict:
        self.file = open(self.path, "a+")
        fcntl.flock(self.file, fcntl.LOCK_EX)
        self.file.seek(0)
        try:
            self.saved = json.loads(self.file.read() or "{}")
        except json.JSONDecodeError:
            self.saved = {}
        return self.saved

    def __exit__(self, *exc) -> None:
        self.file.seek(0)
        self.file.truncate()
        json.dump(self.saved, self.file)
        self.file.close()


def last_reply(transcript_path: str | None) -> str:
    """Text of the final assistant message; one message can span several JSONL entries."""
    if not transcript_path:
        return ""
    entries = []
    with open(transcript_path) as f:
        for line in f:
            entry = json.loads(line)
            if entry.get("type") == "assistant":
                entries.append(entry["message"])
    last_id = next((m.get("id") for m in reversed(entries) if texts(m)), None)
    if last_id is None:
        return ""
    return "\n".join(t for m in entries if m.get("id") == last_id for t in texts(m))


def texts(message: dict) -> list[str]:
    content = message.get("content")
    if isinstance(content, str):
        return [content]
    return [block["text"] for block in content or [] if block.get("type") == "text"]


def speakable(md: str, tagged_only: bool = False) -> tuple[str, str, str]:
    """What to say for a reply: all of it, its announcement alone, and the rest
    without the announcement, for when the announcement was already said.

    Code and tables are dropped, not read. Text marked with <speak> or <announce>
    is spoken alone; without <speak> marks, a read-along reply is spoken whole,
    announcements in place. With tagged_only, unmarked text is not spoken at all."""
    md = re.sub(r"```.*?(```|\Z)", " ", md, flags=re.S)
    # Inline code that names the tags is about them, not a mark.
    md = re.sub(r"`[^`\n]*(?:speak|announce)>[^`\n]*`", " ", md, flags=re.I)
    marked = VOICE_TAG.findall(md)
    announce = "\n".join(text for tag, text in marked if tag.lower() == "announce")
    if any(tag.lower() == "speak" for tag, _ in marked):
        rest = "\n".join(text for tag, text in marked if tag.lower() == "speak")
        md = "\n".join(text for _, text in marked)
    elif tagged_only:
        md, rest = announce, ""
    else:
        rest = ANNOUNCEMENT.sub(" ", md)
        md = ANNOUNCE_TAG.sub("", md)
    return plain(md), plain(announce), plain(rest)


def plain(md: str) -> str:
    """Reduce markdown to what reads well aloud."""
    lines = []
    for line in md.splitlines():
        if line.lstrip().startswith("|"):
            continue
        line = re.sub(r"^\s*(#+|[-*+]|\d+\.)\s+", "", line)
        lines.append(line)
    text = "\n".join(lines)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"https?://\S+", "", text)
    # Inline code that is a path, command, or identifier is noise when spoken.
    text = re.sub(r"`([^`]*)`", lambda m: "" if re.search(r"[/\\=<>{}()]|^-|\.\w+$", m[1]) else m[1], text)
    text = re.sub(r"[*_]{1,3}([^*_\n]+)[*_]{1,3}", r"\1", text)
    text = re.sub(r"[ \t]+", " ", text)
    return re.sub(r"\n{2,}", "\n", text).strip()


def enqueue(session: str, text: str, announce: str = "", rest: str | None = None) -> None:
    """Add text to the session's queue and ring the server to speak it.

    announce is the part of text that is spoken even while the session is not
    focused, and rest is text without it, said once the announcement has been."""
    if not text:
        return
    pending = QUEUES / session
    pending.mkdir(exist_ok=True)
    item = pending / f"{time.time_ns()}.txt"
    entry = {"text": text, "announce": announce, "rest": text if rest is None else rest}
    item.with_suffix(".tmp").write_text(json.dumps(entry))
    item.with_suffix(".tmp").rename(item)
    call({"op": "ring"})


def stop(session: str | None) -> None:
    """Drop the session's queue, or every session's with None, and cut its speech
    if it is playing."""
    if call({"op": "stop", "session": session}, start=False) is None:
        # With no server listening, nothing is playing, so the queue is all there is.
        drop(session)


def call(request: dict, start: bool = True) -> dict | None:
    """Send a request to the server and return its reply, or None if none answered.

    With start, a client that finds no server starts one. A server older than this
    client replies that it will restart, and the client starts the newer one in its
    place whether or not start is set. The new server reads the queues from disk,
    so the request is not sent again."""
    reply = send(request)
    if reply is None and not start:
        return None
    if reply is None or reply.get("restart"):
        with open(START_LOCK, "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            # Another client may have started one while this one waited for the lock.
            if not ready(send({"op": "ring"})):
                launch()
                deadline = time.monotonic() + STARTUP_SECONDS
                while not ready(send({"op": "ring"})) and time.monotonic() < deadline:
                    time.sleep(0.05)
    return reply


def ready(reply: dict | None) -> bool:
    return reply is not None and not reply.get("restart")


def send(request: dict) -> dict | None:
    """One request and its reply, each a line of JSON; None if no server answers."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(5)
            conn.connect(str(SOCKET))
            conn.sendall((json.dumps({**request, "version": VERSION}) + "\n").encode())
            return json.loads(read_line(conn))
    except (OSError, ValueError):
        return None


def read_line(conn: socket.socket) -> bytes:
    data = b""
    while not data.endswith(b"\n"):
        chunk = conn.recv(4096)
        if not chunk:
            break
        data += chunk
    return data


def launch() -> None:
    """Start a server, detached from the session so it outlives it. Each server
    empties the log; appending keeps an older server's last lines readable."""
    log = os.open(LOGS / "server", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_APPEND, 0o644)
    try:
        subprocess.Popen(
            [sys.executable, __file__, "serve"],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            cwd="/",
            start_new_session=True,
        )
    finally:
        os.close(log)


def server_status(reply: dict | None) -> str:
    """The server's status reply as lines for a person, or that none is running."""
    if reply is None:
        return "No chitchat server is running; the next speech starts one."
    if "pid" not in reply:
        # A server from before the status request took it as a ring.
        old = reply.get("version", "unknown")
        return f"A chitchat server {old} is running, older than this plugin's {VERSION}; it exits once it finishes what it is saying, and the next speech starts {VERSION}."
    lines = [f"chitchat server {reply['version']}, pid {reply['pid']}, up {duration(reply['uptime'])}"]
    if reply["idle_exit"] is None:
        lines.append("Stays while speech is queued.")
    else:
        lines.append(f"Exits in {duration(reply['idle_exit'])} unless more speech arrives.")
    lines.append(f"Voices ready: {', '.join(reply['voices']) or 'none yet'}")
    here = os.environ.get("CLAUDE_CODE_SESSION_ID")
    for session, held in reply["sessions"].items():
        label = f"{held['name']} ({session})" if held["name"] else session
        if session == here:
            label += ", this session"
        speaking = ", speaking" if session == reply["speaking"] else ""
        lines.append(f"{label}: {held['queued']} queued, {held['held']} held for focus{speaking}")
    if reply["speaking"] and reply["speaking"] not in reply["sessions"]:
        lines.append(f"{reply['speaking']}: speaking its last item")
    if not reply["sessions"] and not reply["speaking"]:
        lines.append("Nothing queued.")
    return "\n".join(lines)


def duration(seconds: float) -> str:
    seconds = int(seconds)
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {secs}s"
    return f"{secs}s"


def newer(version: str, than: str) -> bool:
    def parts(v: str) -> tuple[int, ...]:
        return tuple(int(n) for n in re.findall(r"\d+", v))

    return parts(version) > parts(than)


def queued(session: str | None = None) -> list[tuple[str, Path]]:
    """Queued items as (session, path), oldest first across sessions, since items
    are named for the time they were queued."""
    if session is not None:
        dirs = [QUEUES / session]
    else:
        dirs = [d for d in QUEUES.iterdir() if d.is_dir()] if QUEUES.exists() else []
    items = sorted((item.name, d.name, item) for d in dirs for item in d.glob("*.txt"))
    return [(s, item) for _, s, item in items]


def drop(session: str | None) -> None:
    for _, item in queued(session):
        item.unlink(missing_ok=True)


def read_entry(item: Path) -> dict | None:
    try:
        raw = item.read_text()
    except FileNotFoundError:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        # Queued as plain text by a version before announcements.
        return {"text": raw, "announce": "", "rest": raw}


def take(item: Path) -> str:
    """Take an item off the queue and return what is left to say for it."""
    entry = read_entry(item)
    item.unlink(missing_ok=True)
    if entry is None:
        return ""
    return entry["rest"] if entry.get("announced") else entry["text"]


def take_announcement(item: Path) -> str:
    """Return an item's announcement if it has not been said, marking it said, so
    the item keeps only the rest for when the session is focused. An item with no
    rest is done once announced."""
    entry = read_entry(item)
    if not entry or not entry.get("announce") or entry.get("announced"):
        return ""
    if not entry.get("rest", "").strip():
        item.unlink(missing_ok=True)
        return entry["announce"]
    entry["announced"] = True
    tmp = item.with_suffix(".tmp")
    tmp.write_text(json.dumps(entry))
    tmp.rename(item)
    return entry["announce"]


def remember_pane(session: str) -> None:
    """Record the session's tmux pane for the worker, from the hook's environment."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        (PANES / session).unlink(missing_ok=True)
        return
    (PANES / session).write_text(json.dumps({"pane": pane, "socket": tmux_socket()}))


def tmux_socket() -> str:
    return os.environ.get("TMUX", "").split(",")[0]


@dataclass
class Pane:
    focused: bool
    window: str = ""


def pane(session: str) -> Pane:
    """The session's tmux pane: whether it is the active pane of the active window
    with a focused client attached, and its window's name. Outside tmux, or when
    tmux cannot say, it counts as focused, with no name."""
    try:
        where = json.loads((PANES / session).read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return Pane(True)
    out = tmux_pane(where["pane"], where.get("socket", ""))
    if out is None:
        return Pane(True)
    found = read_pane(out)
    return found if FOCUS_GATE else Pane(True, found.window)


def read_pane(out: str) -> Pane:
    """Read tmux_pane's answer. client_flags is a comma-separated list, such as
    attached,focused,UTF-8; tmux has no client_focused format to read instead."""
    first, *clients = out.splitlines() or [""]
    active, _, window = first.partition("\t")
    focused = active == "11" and any("focused" in flags.split(",") for flags in clients)
    return Pane(focused, window)


def tmux_pane(pane: str, socket: str) -> str | None:
    """tmux's answer for the pane: a line with pane_active and window_active, a tab,
    and the window name, then client_flags for each client attached to its session.
    None if tmux fails."""
    cmd = ["tmux", *(["-S", socket] if socket else [])]
    cmd += ["display-message", "-p", "-t", pane, "#{pane_active}#{window_active}\t#{window_name}"]
    cmd += [";", "list-clients", "-t", pane, "-F", "#{client_flags}"]
    try:
        run = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return run.stdout if run.returncode == 0 else None


SPOKE, HELD, EMPTY = "spoke", "held", "empty"


def serve() -> None:
    sys.stdout.reconfigure(line_buffering=True)
    server = Server()
    if not server.listen():
        return
    print(f"chitchat {server.version}: serving", flush=True)
    scheduler = threading.Thread(target=server.run)
    scheduler.start()
    server.accept()
    scheduler.join()
    print(f"chitchat {server.version}: exiting", flush=True)


class Server:
    """The one process that speaks for every session.

    Requests are answered on one thread and speech is scheduled on another. The
    queues live on disk, so the scheduler reads them as it goes, and a ring only
    wakes it. self.lock guards taking an item off the queue against stop(), so a
    stop either finds the item still queued or finds it being said and cuts it."""

    def __init__(self, version: str = VERSION):
        self.version = version
        self.lock = threading.Lock()
        self.wake = threading.Event()
        # Set by stop() to cut the item being said.
        self.cancel = threading.Event()
        self.closing = False
        # The session whose item is being said, while one is.
        self.current: str | None = None
        self.player: subprocess.Popen | None = None
        self.started = self.last_active = time.monotonic()
        self.model = None
        # Each voice's prepared conditionals, with the sample's mtime they came from.
        self.voices: dict[str, tuple[int, object]] = {}
        self.listener: socket.socket | None = None
        self.listen_lock = None

    def listen(self) -> bool:
        """Take the socket, unless another server keeps it past the startup wait."""
        lock = open(LISTEN_LOCK, "w")
        deadline = time.monotonic() + STARTUP_SECONDS
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    lock.close()
                    return False
                time.sleep(0.05)
        SOCKET.unlink(missing_ok=True)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(SOCKET))
        listener.listen()
        self.listener, self.listen_lock = listener, lock
        return True

    def close(self) -> None:
        """Stop listening, so the next client starts a new server."""
        if self.listener is None:
            return
        SOCKET.unlink(missing_ok=True)
        self.listen_lock.close()
        self.listener.close()
        self.listener = self.listen_lock = None

    def accept(self) -> None:
        """Answer requests until the server is replaced, or idle with nothing queued."""
        while not self.closing:
            ready, _, _ = select.select([self.listener], [], [], IDLE_CHECK_SECONDS)
            if ready:
                self.answer()
                continue
            # Clients write the queue file before ringing, so under the lock an
            # empty queue means no ring is on its way for anything queued.
            with self.lock:
                idle = time.monotonic() - self.last_active >= IDLE_SECONDS
                if idle and self.current is None and not queued():
                    self.closing = True
        self.close()
        self.wake.set()

    def answer(self) -> None:
        try:
            conn, _ = self.listener.accept()
        except OSError:
            return
        with conn:
            try:
                conn.settimeout(5)
                reply = self.handle(json.loads(read_line(conn)))
                if self.closing:
                    # Closed before replying, so the client told to start a newer
                    # server finds none listening.
                    self.close()
                conn.sendall((json.dumps(reply) + "\n").encode())
            except (OSError, ValueError):
                pass

    def handle(self, request: dict) -> dict:
        """Answer one request: a ring, which only wakes the scheduler, a stop, or a
        status. A ring or stop from a newer client closes this server."""
        if request.get("op") == "status":
            return self.status()
        with self.lock:
            self.last_active = time.monotonic()
            if request.get("op") == "stop":
                self.stop(request.get("session"))
            restart = newer(str(request.get("version", "")), self.version)
            if restart:
                self.closing = True
        self.wake.set()
        return {"version": self.version, "restart": restart}

    def status(self) -> dict:
        """What the server holds, for `chitchat server`. It leaves the idle clock
        alone, and reads tmux outside the lock so the scheduler is not held up."""
        with self.lock:
            uptime = time.monotonic() - self.started
            idle_for = time.monotonic() - self.last_active
            current = self.current
            voices = sorted(self.voices)
        counts: dict[str, int] = {}
        for session, _ in queued():
            counts[session] = counts.get(session, 0) + 1
        sessions = {}
        for session, count in sorted(counts.items()):
            found = pane(session)
            sessions[session] = {
                "name": name(session, found.window),
                "queued": count if found.focused else 0,
                "held": 0 if found.focused else count,
            }
        # The server stays while anything is queued or being said.
        idle_exit = None if current or counts else max(IDLE_SECONDS - idle_for, 0.0)
        return {
            "version": self.version,
            "restart": False,
            "pid": os.getpid(),
            "uptime": uptime,
            "idle_exit": idle_exit,
            "speaking": current,
            "voices": voices,
            "sessions": sessions,
        }

    def stop(self, session: str | None) -> None:
        """Drop the session's queue, or every session's with None, and cut its
        speech if it is being said. Called with self.lock held."""
        drop(session)
        if self.current is not None and session in (None, self.current):
            self.cancel.set()
            if self.player is not None:
                self.player.terminate()

    def run(self) -> None:
        """Speak once this server owns the audio, until it closes."""
        try:
            with open(AUDIO_LOCK, "w") as lock:
                while not self.closing:
                    try:
                        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        break
                    except BlockingIOError:
                        time.sleep(POLL_SECONDS)
                else:
                    return
                try:
                    self.schedule()
                finally:
                    restore()
        except Exception:
            traceback.print_exc()
        finally:
            # A scheduler that failed must not leave a server that answers but never speaks.
            self.closing = True
            self.wake.set()

    def schedule(self) -> None:
        """Speak the queues until the server closes, finishing the item being said."""
        while not self.closing:
            self.wake.clear()
            state = self.step()
            if state == SPOKE:
                continue
            # Held speech counts as silent, so the music comes back up while it waits.
            restore()
            if not self.wait(POLL_SECONDS if state == HELD else None):
                return

    def wait(self, seconds: float | None) -> bool:
        """Wait for a ring, or the given seconds; False once the server is closing."""
        self.wake.wait(seconds)
        return not self.closing

    def step(self) -> str:
        """Say the next thing, and return SPOKE, or HELD when everything queued
        waits for its session's focus, or EMPTY.

        An announcement not yet said, from a session that is not focused, goes
        first, starting with the session's name. Otherwise the oldest item from a
        focused session is said whole, or without its announcement if that was
        already said. Focus is checked each time, so speech queued while focused
        waits once the listener looks away."""
        items = queued()
        if not items:
            return EMPTY
        panes = {session: pane(session) for session in {s for s, _ in items}}
        with self.lock:
            pick = None
            for session, item in items:
                if not panes[session].focused and (text := take_announcement(item)):
                    who = name(session, panes[session].window)
                    # A line of its own is a clip of its own, so a pause follows the name.
                    pick = session, f"{who}.\n{text}" if who else text
                    break
            else:
                for session, item in items:
                    if panes[session].focused:
                        pick = session, take(item)
                        break
            if pick is None:
                return HELD
            self.current = pick[0]
            self.cancel.clear()
        try:
            self.say(*pick)
        except Exception:
            traceback.print_exc()
        finally:
            with self.lock:
                self.current = None
                self.last_active = time.monotonic()
        return SPOKE

    def say(self, session: str, text: str) -> None:
        if not text or self.cancel.is_set():
            return
        # The choice is read per item, so a change applies from the next message.
        chosen = self.voice_for(session)
        if chosen is None:
            return
        self.use_voice(chosen)
        self.speak(text, session)

    def voice_for(self, session: str) -> str | None:
        """The session's voice, or the default when the chosen voice has no sample;
        None, skipping the message, when the default has none either."""
        chosen = voice(session)
        if (VOICES / f"{chosen}.wav").exists():
            return chosen
        if chosen != DEFAULT_VOICE and (VOICES / f"{DEFAULT_VOICE}.wav").exists():
            warn(f"no voice {chosen!r} in {VOICES}; speaking {session} in the default voice, {DEFAULT_VOICE!r}")
            return DEFAULT_VOICE
        missing = f"{chosen!r} or the default, {DEFAULT_VOICE!r}" if chosen != DEFAULT_VOICE else repr(chosen)
        warn(f"no voice {missing} in {VOICES}; skipped a message from {session}")
        return None

    def use_voice(self, chosen: str) -> None:
        """Give the model the voice, preparing it the first time it is asked for,
        or again once its sample changes. prepare_conditionals leaves the voice in
        the model's _conds, the only voice state generate() reads, so a voice
        prepared before is swapped back in there."""
        path = VOICES / f"{chosen}.wav"
        mtime = path.stat().st_mtime_ns
        if self.model is None:
            self.model = load()
        cached = self.voices.get(chosen)
        if cached and cached[0] == mtime:
            self.model._conds = cached[1]
            return
        self.model.prepare_conditionals(str(path))
        self.voices[chosen] = (mtime, self.model._conds)

    def speak(self, text: str, session: str) -> None:
        import soundfile

        clips: queue.Queue[Path | None] = queue.Queue()
        player = threading.Thread(target=self.play, args=(clips, session))
        player.start()
        with tempfile.TemporaryDirectory() as tmp:
            try:
                # Each line is generated on its own, so playback starts after the first
                # line and the gap between clips, mostly afplay startup, falls at a line
                # break. Turbo still splits a line longer than about 400 characters.
                lines = [line for line in text.splitlines() if line.strip()]
                results = (r for line in lines for r in self.model.generate(text=line))
                for i, result in enumerate(results):
                    if self.cancel.is_set():
                        break
                    clip = Path(tmp) / f"{i}.wav"
                    soundfile.write(clip, result.audio, result.sample_rate)
                    clips.put(clip)
            finally:
                clips.put(None)
                player.join()

    def play(self, clips: queue.Queue, session: str) -> None:
        """Play clips as they are generated, until stop() cuts them."""
        ducked = False
        while (clip := clips.get()) is not None:
            if self.cancel.is_set():
                continue
            if not ducked:
                duck()
                ducked = True
            with self.lock:
                if self.cancel.is_set():
                    continue
                # Turbo has no speed control, so playback sets the rate.
                player = self.player = subprocess.Popen(["afplay", "-r", speed(session), "-q", "1", str(clip)])
            player.wait()
            with self.lock:
                self.player = None


def warn(message: str) -> None:
    print(f"chitchat: {message}", file=sys.stderr, flush=True)


def load():
    from mlx_audio.tts.utils import load_model

    return load_model(MODEL)


def duck_level() -> int | None:
    if DUCK_LEVEL.strip().lower() == "off":
        return None
    try:
        return min(max(int(DUCK_LEVEL), 0), 100)
    except ValueError:
        return None


def duck() -> None:
    """Lower Spotify for speech, saving its volume first. A volume already saved is
    from speech still going on, or from a server that died before restoring it."""
    level = duck_level()
    if level is None or DUCKED.exists():
        return
    volume = spotify_volume()
    if volume is None:
        return
    # Saved before lowering, so a crash in between restores a volume, not loses one.
    DUCKED.write_text(str(volume))
    if volume > level:
        spotify_volume(level)


def restore() -> None:
    """Put Spotify back at its saved volume. A volume the user changed while ducked
    is overwritten, not fought."""
    if not DUCKED.exists():
        return
    try:
        spotify_volume(int(DUCKED.read_text()))
    except ValueError:
        pass
    DUCKED.unlink(missing_ok=True)


def restore_unowned() -> None:
    """Restore Spotify for a server that died while it was lowered. A live server
    holds the audio lock and restores it itself."""
    with open(AUDIO_LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        restore()


def spotify_volume(level: int | None = None) -> int | None:
    """Spotify's volume, after setting it to level if given. None when Spotify is
    not running, since asking it would launch it."""
    set_volume = f"set sound volume to {level}\n" if level is not None else ""
    script = (
        'if application "Spotify" is running then\n'
        f'tell application "Spotify"\n{set_volume}return sound volume\nend tell\n'
        "end if"
    )
    try:
        out = subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=10
        ).stdout.strip()
        return int(out)
    except (subprocess.TimeoutExpired, ValueError):
        return None


if __name__ == "__main__":
    main()
