#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12,<3.13"
# dependencies = [
#   "mlx-audio==0.6.6",
#   "soundfile==0.14.0",
# ]
# ///
"""Speak Claude Code replies aloud in a voice cloned locally with Chatterbox Turbo.

Speech is enabled per Claude Code session. Each session speaks its messages in
order, one at a time. Sessions that speak at the same time take turns. A new
prompt silences whatever its session had left to say.

A voice is a WAV sample in $XDG_DATA_HOME/chitchat/voices, named for its
file: voices/data.wav is the voice "data". Chatterbox needs more than 5 seconds
and uses only the first 15. $CHITCHAT_VOICE names the default voice, and
$CHITCHAT_SPEED sets the default rate.

While any session speaks, a running Spotify is lowered to $CHITCHAT_DUCK percent
(default 30), and restored once nothing is left to speak; CHITCHAT_DUCK=off
leaves Spotify alone.

Ordinary speech plays only while its session's tmux pane is focused, and waits
in the queue otherwise, playing once the session is focused again. Text in
<announce> tags speaks right away regardless, and so does text written before a
tool call, outside tagged mode, as the call starts. CHITCHAT_FOCUS=off speaks
everything, focused or not.

Speech that plays while its session is not focused starts with the session's
name. The name is the tmux window's, with a leading fm- dropped and dashes read as
spaces, unless `chitchat name` sets one.

In a Claude Code session, run these through the /chitchat skill: /chitchat
alone toggles speech, and /chitchat COMMAND runs on, off, toggle, status,
voice, speed, name, or stop.

  chitchat on|off|toggle|status   enable or disable speech for this session
  chitchat on tagged              speak only text in <speak> or <announce> tags, for an agent the
                                  listener supervises rather than reads along with
  chitchat voice [NAME]           list voices, or choose this session's voice
  chitchat speed [RATE]           show or set this session's playback rate
  chitchat name [NAME|--clear]    show or set the name said before this session's speech
                                  while it is not focused; --clear goes back to the window name
  chitchat stop                   stop this session's speech; outside a session, all
  chitchat hook                   Stop hook: speak the last reply if enabled
  chitchat pretool                speak text written before a tool call, given as a JSON list
                                  on stdin by the hooks module as the call starts, focused or not
  chitchat prompt                 UserPromptSubmit hook: ask for speakable replies
  chitchat end                    SessionEnd hook: forget the session
  chitchat say [SESSION]          speak text read from stdin, focused or not
"""

import fcntl
import json
import os
import queue
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass
from pathlib import Path

MODEL = "mlx-community/chatterbox-turbo-fp16"
DEFAULT_SPEED = os.environ.get("CHITCHAT_SPEED", "1.1")

DEFAULT_VOICE = os.environ.get("CHITCHAT_VOICE", "default")
DUCK_LEVEL = os.environ.get("CHITCHAT_DUCK", "30")
FOCUS_GATE = os.environ.get("CHITCHAT_FOCUS", "on").strip().lower() != "off"

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "chitchat"
VOICES = DATA / "voices"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "chitchat"
ENABLED = STATE / "sessions"
CHOSEN = STATE / "chosen-voices"
SPEEDS = STATE / "speeds"
NAMES = STATE / "names"
PIDS = STATE / "pids"
LOGS = STATE / "logs"
QUEUES = STATE / "queues"
WORKERS = STATE / "workers"
OFFSETS = STATE / "offsets"
PANES = STATE / "panes"
# A session whose worker is holding speech until it is focused; it counts as silent.
HELD = STATE / "held"
PLAY_LOCK = STATE / "play.lock"
# Spotify's volume from before speech lowered it, kept until it is restored, so a run
# that is killed or crashes is restored by the next one.
DUCKED = STATE / "ducked"
DUCK_LOCK = STATE / "duck.lock"
# Keys in a session's offsets; real keys are paths. SPOKEN is the last reply the Stop
# hook spoke, and SAID the texts pretool spoke this turn.
SPOKEN = "spoken"
SAID = "said"

VOICE_MODE = """\
Voice mode is on: your whole reply is also read aloud by text-to-speech while the \
listener reads along, so write one reply that works both ways. Code blocks, tables, URLs, \
and inline code that looks like a path or command are skipped when spoken. Right before a \
code block or table, write one plain sentence saying what it shows, the way an engineer \
would point at it, so the listener hears that while reading it. Don't let a path or \
identifier in inline code carry a sentence's meaning alone, and write numbers so they \
read naturally. Speech plays only while the listener is looking at this session, and \
waits for them to come back otherwise. For the rare update they should hear right away \
from another session, such as a merge, a failure, or a decision waiting on them, wrap \
one or two short sentences in <announce>...</announce>; they are read once."""

VOICE_TAGGED = """\
Speech is on in tagged mode: only text inside <speak>...</speak> is read aloud, and \
everything else stays silent. Most replies need no tags. Wrap only an important update \
in them, such as a finished milestone, a failure, a blocker, or a decision that is \
needed, in one or two short plain sentences with numbers written so they read naturally. \
Spoken text plays only while the listener is looking at this session, and waits \
for them to come back otherwise. Use <announce>...</announce> instead, rarely, for an \
update they should hear right away even while looking at another session. The tags are \
hidden on screen."""

# A tag still open at the end is a reply that is streaming in.
VOICE_TAG = re.compile(r"<(speak|announce)>(.*?)(?:</\1>|\Z)", re.S | re.I)
ANNOUNCE_TAG = re.compile(r"</?announce>", re.I)
ANNOUNCEMENT = re.compile(r"<announce>.*?(?:</announce>|\Z)", re.S | re.I)
# How often a worker holding speech for an unfocused session checks for the listener.
POLL_SECONDS = 0.5


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    for d in (ENABLED, CHOSEN, SPEEDS, NAMES, PIDS, LOGS, QUEUES, WORKERS, OFFSETS, PANES, HELD, VOICES):
        d.mkdir(parents=True, exist_ok=True)
    if cmd != "worker" and DUCKED.exists():
        restore()
    if cmd in ("on", "off", "toggle", "status"):
        toggle(cmd, current_session(), sys.argv[2] if len(sys.argv) > 2 else "")
    elif cmd == "voice":
        choose_voice(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "speed":
        choose_speed(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "name":
        choose_name(" ".join(sys.argv[2:]).strip() or None)
    elif cmd == "stop":
        session = os.environ.get("CLAUDE_CODE_SESSION_ID")
        for s in [session] if session else [p.name for p in PIDS.iterdir()]:
            stop(s)
    elif cmd == "hook":
        hook(json.load(sys.stdin))
    elif cmd == "pretool":
        pretool(os.environ.get("CLAUDE_CODE_SESSION_ID"), json.load(sys.stdin))
    elif cmd == "prompt":
        event = json.load(sys.stdin)
        session = event.get("session_id")
        if enabled(session):
            # A background task notification arrives as a prompt too, but only a
            # prompt the user typed should cut off speech.
            if not event.get("prompt", "").lstrip().startswith("<task-notification>"):
                stop(session)
            remember_pane(session)
            skip_to_end(session, event.get("transcript_path"))
            # A turn cut off before its Stop hook leaves what pretool() said behind.
            with offsets(session) as saved:
                saved.pop(SAID, None)
            print(VOICE_TAGGED if tagged(session) else VOICE_MODE)
    elif cmd == "end":
        session = json.load(sys.stdin).get("session_id")
        if session:
            (ENABLED / session).unlink(missing_ok=True)
            (OFFSETS / session).unlink(missing_ok=True)
            (CHOSEN / session).unlink(missing_ok=True)
            (SPEEDS / session).unlink(missing_ok=True)
            (NAMES / session).unlink(missing_ok=True)
            (PANES / session).unlink(missing_ok=True)
            stop(session)
    elif cmd == "say":
        text = sys.stdin.read()
        enqueue(sys.argv[2] if len(sys.argv) > 2 else "manual", text, text, "")
    elif cmd == "worker":
        worker(sys.argv[2])
    else:
        sys.exit(__doc__)


def current_session() -> str:
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not session:
        sys.exit("chitchat: run inside a Claude Code session, as `/chitchat on`")
    return session


def enabled(session: str | None) -> bool:
    return bool(session) and (ENABLED / session).exists()


def tagged(session: str | None) -> bool:
    return enabled(session) and (ENABLED / session).read_text().strip() == "tagged"


def toggle(cmd: str, session: str, mode: str) -> None:
    if mode not in ("", "tagged"):
        sys.exit(f"chitchat: unknown mode {mode!r}; the only mode is tagged")
    if cmd == "toggle":
        cmd = "off" if enabled(session) else "on"
    if cmd == "on":
        (ENABLED / session).write_text(mode)
        remember_pane(session)
    elif cmd == "off":
        (ENABLED / session).unlink(missing_ok=True)
        stop(session)
    if not enabled(session):
        print("speech off")
    else:
        print("speech on, tagged" if tagged(session) else "speech on")


def voice(session: str) -> str:
    chosen = CHOSEN / session
    return chosen.read_text().strip() if chosen.exists() else DEFAULT_VOICE


def choose_voice(name: str | None) -> None:
    session = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if name is None:
        current = voice(session) if session else DEFAULT_VOICE
        for v in sorted(f.stem for f in VOICES.glob("*.wav")):
            print(f"{'*' if v == current else ' '} {v}")
        return
    if not (VOICES / f"{name}.wav").exists():
        sys.exit(f"chitchat: no voice {name!r} in {VOICES}")
    (CHOSEN / current_session()).write_text(name)
    print(f"voice {name}")


def speed(session: str) -> str:
    chosen = SPEEDS / session
    return chosen.read_text().strip() if chosen.exists() else DEFAULT_SPEED


def choose_speed(rate: str | None) -> None:
    session = current_session()
    if rate is not None:
        try:
            ok = 0.5 <= float(rate) <= 2
        except ValueError:
            ok = False
        if not ok:
            sys.exit("chitchat: speed is a rate from 0.5 to 2")
        (SPEEDS / session).write_text(rate)
    print(f"speed {speed(session)}")


def name(session: str, window: str) -> str:
    """The name said before the session's unfocused speech: the one chosen, or else
    the window's. Worker windows are named fm-<task-id>."""
    chosen = NAMES / session
    if chosen.exists():
        return chosen.read_text().strip()
    return window.removeprefix("fm-").replace("-", " ").strip()


def choose_name(new: str | None) -> None:
    session = current_session()
    if new == "--clear":
        (NAMES / session).unlink(missing_ok=True)
    elif new is not None:
        (NAMES / session).write_text(new)
    pane = os.environ.get("TMUX_PANE")
    window = tmux_pane(pane, tmux_socket()) if pane else None
    current = name(session, read_pane(window).window if window else "")
    print(f"name {current}" if current else "no name; outside tmux, nothing is said first")


def hook(event: dict) -> None:
    session = event.get("session_id")
    if not enabled(session):
        return
    transcript = event.get("transcript_path")
    text = event.get("last_assistant_message") or last_reply(transcript) or ""
    with offsets(session) as saved:
        said = saved.pop(SAID, [])
    # Text written before a tool call was spoken by pretool() as the call started. Any
    # left is text the hooks module did not see, spoken late rather than not at all.
    pending = [t for t in new_texts(session, transcript) if t.strip() not in text and t.strip() not in said]
    # The final reply is spoken from the event, so a later Stop hook must not speak it again.
    # Skipping to the end is not enough: the reply can reach the transcript after this
    # hook runs, and a ! command fires no prompt hook to skip past it later.
    skip_to_end(session, transcript)
    with offsets(session) as saved:
        saved[SPOKEN] = text
    remember_pane(session)
    enqueue(session, *pre_tool("\n".join(pending), tagged(session)))
    # A turn whose last message has no text falls back to an earlier one, which can be
    # text pretool() already spoke.
    if text.strip() not in said:
        enqueue(session, *speakable(text, tagged(session)))


def pretool(session: str | None, texts: list[str]) -> None:
    """Speak text the hooks module read from a response as one of its tool calls began,
    and note it, so the Stop hook does not speak it again from the transcript."""
    if not enabled(session):
        return
    with offsets(session) as saved:
        saved[SAID] = [*saved.get(SAID, []), *(t.strip() for t in texts)]
    remember_pane(session)
    enqueue(session, *pre_tool("\n".join(texts), tagged(session)))


def pre_tool(md: str, tagged_only: bool) -> tuple[str, str, str]:
    """What to say for text written before a tool call. Outside tagged mode it is
    all an announcement, spoken right away whether the session is focused or not."""
    if tagged_only:
        return speakable(md, True)
    text = speakable(md)[0]
    return text, text, ""


def new_texts(session: str, transcript_path: str | None) -> list[str]:
    """Assistant text added to the transcript since this session last read it.

    The offset is kept per transcript path, since a subagent's tool calls may
    report its own transcript. With no offset yet, nothing is read, so turning
    speech on mid-session does not replay the history."""
    if not transcript_path:
        return []
    with offsets(session) as saved:
        start = saved.get(transcript_path)
        with open(transcript_path, "rb") as f:
            if start is None or start > os.fstat(f.fileno()).st_size:
                saved[transcript_path] = f.seek(0, os.SEEK_END)
                return []
            f.seek(start)
            data = f.read()
        # A line still being written is left for the next read.
        end = data.rfind(b"\n") + 1
        saved[transcript_path] = start + end
        spoken = saved.get(SPOKEN, "")
    found = []
    for line in data[:end].splitlines():
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("type") == "assistant" and not entry.get("isSidechain"):
            found += [t for t in texts(entry["message"]) if t.strip() not in spoken]
    return found


def skip_to_end(session: str, transcript_path: str | None) -> None:
    if not transcript_path:
        return
    with offsets(session) as saved:
        try:
            saved[transcript_path] = os.path.getsize(transcript_path)
        except FileNotFoundError:
            pass


class offsets:
    """The session's transcript offsets, read and written under a lock, since
    parallel tool calls run their hooks at the same time."""

    def __init__(self, session: str):
        self.path = OFFSETS / session

    def __enter__(self) -> dict:
        self.file = open(self.path, "a+")
        fcntl.flock(self.file, fcntl.LOCK_EX)
        self.file.seek(0)
        try:
            self.saved = json.loads(self.file.read() or "{}")
        except json.JSONDecodeError:
            self.saved = {}
        return self.saved

    def __exit__(self, *exc) -> None:
        self.file.seek(0)
        self.file.truncate()
        json.dump(self.saved, self.file)
        self.file.close()


def last_reply(transcript_path: str | None) -> str:
    """Text of the final assistant message; one message can span several JSONL entries."""
    if not transcript_path:
        return ""
    entries = []
    with open(transcript_path) as f:
        for line in f:
            entry = json.loads(line)
            if entry.get("type") == "assistant":
                entries.append(entry["message"])
    last_id = next((m.get("id") for m in reversed(entries) if texts(m)), None)
    if last_id is None:
        return ""
    return "\n".join(t for m in entries if m.get("id") == last_id for t in texts(m))


def texts(message: dict) -> list[str]:
    content = message.get("content")
    if isinstance(content, str):
        return [content]
    return [block["text"] for block in content or [] if block.get("type") == "text"]


def speakable(md: str, tagged_only: bool = False) -> tuple[str, str, str]:
    """What to say for a reply: all of it, its announcement alone, and the rest
    without the announcement, for when the announcement was already said.

    Code and tables are dropped, not read. Text marked with <speak> or <announce>
    is spoken alone; without <speak> marks, a read-along reply is spoken whole,
    announcements in place. With tagged_only, unmarked text is not spoken at all."""
    md = re.sub(r"```.*?(```|\Z)", " ", md, flags=re.S)
    # Inline code that names the tags is about them, not a mark.
    md = re.sub(r"`[^`\n]*(?:speak|announce)>[^`\n]*`", " ", md, flags=re.I)
    marked = VOICE_TAG.findall(md)
    announce = "\n".join(text for tag, text in marked if tag.lower() == "announce")
    if any(tag.lower() == "speak" for tag, _ in marked):
        rest = "\n".join(text for tag, text in marked if tag.lower() == "speak")
        md = "\n".join(text for _, text in marked)
    elif tagged_only:
        md, rest = announce, ""
    else:
        rest = ANNOUNCEMENT.sub(" ", md)
        md = ANNOUNCE_TAG.sub("", md)
    return plain(md), plain(announce), plain(rest)


def plain(md: str) -> str:
    """Reduce markdown to what reads well aloud."""
    lines = []
    for line in md.splitlines():
        if line.lstrip().startswith("|"):
            continue
        line = re.sub(r"^\s*(#+|[-*+]|\d+\.)\s+", "", line)
        lines.append(line)
    text = "\n".join(lines)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"https?://\S+", "", text)
    # Inline code that is a path, command, or identifier is noise when spoken.
    text = re.sub(r"`([^`]*)`", lambda m: "" if re.search(r"[/\\=<>{}()]|^-|\.\w+$", m[1]) else m[1], text)
    text = re.sub(r"[*_]{1,3}([^*_\n]+)[*_]{1,3}", r"\1", text)
    text = re.sub(r"[ \t]+", " ", text)
    return re.sub(r"\n{2,}", "\n", text).strip()


def enqueue(session: str, text: str, announce: str = "", rest: str | None = None) -> None:
    """Add text to the session's queue and make sure a worker is speaking it.

    announce is the part of text that is spoken even while the session is not
    focused, and rest is text without it, said once the announcement has been."""
    if not text:
        return
    pending = QUEUES / session
    pending.mkdir(exist_ok=True)
    item = pending / f"{time.time_ns()}.txt"
    entry = {"text": text, "announce": announce, "rest": text if rest is None else rest}
    item.with_suffix(".tmp").write_text(json.dumps(entry))
    item.with_suffix(".tmp").rename(item)
    # A worker that is already running exits at once; see worker() for why that is safe.
    subprocess.Popen(
        [sys.executable, __file__, "worker", session],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def worker(session: str) -> None:
    """Speak the session's queue in order until it is empty.

    Only the worker holding the session's lock speaks. After releasing it, the
    worker looks at the queue once more: an item added while it held the lock
    found the lock taken and started no worker of its own, so this one must
    take it.

    Focus is checked as each item comes up, so speech queued while focused stops
    when the listener looks away. While the session is not focused, the worker
    says any new announcements and otherwise waits, holding the rest in order
    until the session is focused again."""
    pending = QUEUES / session
    model = None
    loaded_voice = None
    logging = False

    def say(text: str) -> None:
        nonlocal model, loaded_voice
        if not text:
            return
        if model is None:
            model = load()
        # The choice is read per item, so a change applies from the next message.
        if (chosen := voice(session)) != loaded_voice:
            model.prepare_conditionals(str(VOICES / f"{chosen}.wav"))
            loaded_voice = chosen
        speak(model, text, session)

    while True:
        with open(WORKERS / session, "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            (PIDS / session).write_text(str(os.getpid()))
            if not logging:
                # Each worker replaces the session's log, so it holds only its own output.
                log = os.open(LOGS / session, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
                os.dup2(log, 1)
                os.dup2(log, 2)
                logging = True
            while item := next_item(pending):
                (HELD / session).unlink(missing_ok=True)
                where = pane(session)
                if where.focused:
                    say(take(item))
                    continue
                for waiting in sorted(pending.glob("*.txt")):
                    if text := take_announcement(waiting):
                        who = name(session, where.window)
                        # A line of its own is a clip of its own, so a pause follows the name.
                        say(f"{who}.\n{text}" if who else text)
                # A held session counts as silent, so other sessions play and the
                # music comes back up while this one waits; play() ducks it again.
                (HELD / session).touch()
                restore()
                time.sleep(POLL_SECONDS)
            (HELD / session).unlink(missing_ok=True)
            pidfile = PIDS / session
            if pidfile.exists() and pidfile.read_text() == str(os.getpid()):
                pidfile.unlink()
        if not next_item(pending):
            restore()
            return


def read_entry(item: Path) -> dict | None:
    try:
        raw = item.read_text()
    except FileNotFoundError:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        # Queued as plain text by a version before announcements.
        return {"text": raw, "announce": "", "rest": raw}


def take(item: Path) -> str:
    """Take an item off the queue and return what is left to say for it."""
    entry = read_entry(item)
    item.unlink(missing_ok=True)
    if entry is None:
        return ""
    return entry["rest"] if entry.get("announced") else entry["text"]


def take_announcement(item: Path) -> str:
    """Return an item's announcement if it has not been said, marking it said, so
    the item keeps only the rest for when the session is focused."""
    entry = read_entry(item)
    if not entry or not entry.get("announce") or entry.get("announced"):
        return ""
    entry["announced"] = True
    tmp = item.with_suffix(".tmp")
    tmp.write_text(json.dumps(entry))
    tmp.rename(item)
    return entry["announce"]


def remember_pane(session: str) -> None:
    """Record the session's tmux pane for the worker, from the hook's environment."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        (PANES / session).unlink(missing_ok=True)
        return
    (PANES / session).write_text(json.dumps({"pane": pane, "socket": tmux_socket()}))


def tmux_socket() -> str:
    return os.environ.get("TMUX", "").split(",")[0]


@dataclass
class Pane:
    focused: bool
    window: str = ""


def pane(session: str) -> Pane:
    """The session's tmux pane: whether it is the active pane of the active window
    with a focused client attached, and its window's name. Outside tmux, or when
    tmux cannot say, it counts as focused, with no name."""
    try:
        where = json.loads((PANES / session).read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return Pane(True)
    out = tmux_pane(where["pane"], where.get("socket", ""))
    if out is None:
        return Pane(True)
    found = read_pane(out)
    return found if FOCUS_GATE else Pane(True, found.window)


def read_pane(out: str) -> Pane:
    """Read tmux_pane's answer. client_flags is a comma-separated list, such as
    attached,focused,UTF-8; tmux has no client_focused format to read instead."""
    first, *clients = out.splitlines() or [""]
    active, _, window = first.partition("\t")
    focused = active == "11" and any("focused" in flags.split(",") for flags in clients)
    return Pane(focused, window)


def tmux_pane(pane: str, socket: str) -> str | None:
    """tmux's answer for the pane: a line with pane_active and window_active, a tab,
    and the window name, then client_flags for each client attached to its session.
    None if tmux fails."""
    cmd = ["tmux", *(["-S", socket] if socket else [])]
    cmd += ["display-message", "-p", "-t", pane, "#{pane_active}#{window_active}\t#{window_name}"]
    cmd += [";", "list-clients", "-t", pane, "-F", "#{client_flags}"]
    try:
        run = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return run.stdout if run.returncode == 0 else None


def next_item(pending: Path) -> Path | None:
    items = sorted(pending.glob("*.txt")) if pending.exists() else []
    return items[0] if items else None


def load():
    from mlx_audio.tts.utils import load_model

    return load_model(MODEL)


def speak(model, text: str, session: str) -> None:
    import soundfile

    clips: queue.Queue[Path | None] = queue.Queue()
    player = threading.Thread(target=play, args=(clips, session))
    player.start()
    with tempfile.TemporaryDirectory() as tmp:
        try:
            # Each line is generated on its own, so playback starts after the first
            # line and the gap between clips, mostly afplay startup, falls at a line
            # break. Turbo still splits a line longer than about 400 characters.
            lines = [line for line in text.splitlines() if line.strip()]
            results = (r for line in lines for r in model.generate(text=line))
            for i, result in enumerate(results):
                clip = Path(tmp) / f"{i}.wav"
                soundfile.write(clip, result.audio, result.sample_rate)
                clips.put(clip)
        finally:
            clips.put(None)
            player.join()


def play(clips: queue.Queue, session: str) -> None:
    clip = clips.get()
    if clip is None:
        return
    # Sessions take turns. Generation keeps going while this waits, and the lock is
    # released when the process exits, including when stop() kills it.
    with open(PLAY_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        duck()
        while clip is not None:
            # Turbo has no speed control, so playback sets the rate.
            subprocess.run(["afplay", "-r", speed(session), "-q", "1", str(clip)])
            clip = clips.get()


def stop(session: str) -> None:
    """Drop the session's queue and kill its worker, with any afplay it started."""
    for item in (QUEUES / session).glob("*.txt"):
        item.unlink(missing_ok=True)
    (HELD / session).unlink(missing_ok=True)
    kill_worker(session)
    restore()


def kill_worker(session: str) -> None:
    pidfile = PIDS / session
    try:
        pid = int(pidfile.read_text())
    except (FileNotFoundError, ValueError):
        return
    pidfile.unlink(missing_ok=True)
    if pid == os.getpid():
        return
    if is_chitchat(pid):
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass


def is_chitchat(pid: int) -> bool:
    """Guards against a reused pid: true only for a process that is still chitchat."""
    ps = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
    return "chitchat" in ps.stdout


def duck_level() -> int | None:
    if DUCK_LEVEL.strip().lower() == "off":
        return None
    try:
        return min(max(int(DUCK_LEVEL), 0), 100)
    except ValueError:
        return None


def duck() -> None:
    """Lower Spotify for speech. Ducking is global: the first speaker saves the
    volume and lowers it, and later speakers find it saved and leave it alone."""
    level = duck_level()
    if level is None:
        return
    with open(DUCK_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if DUCKED.exists():
            return
        volume = spotify_volume()
        if volume is None:
            return
        # Saved before lowering, so a crash in between restores a volume, not loses one.
        DUCKED.write_text(str(volume))
        if volume > level:
            spotify_volume(level)


def restore() -> None:
    """Put Spotify back at its saved volume once no session has speech playing or
    queued. A volume the user changed while ducked is overwritten, not fought."""
    with open(DUCK_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not DUCKED.exists() or speaking():
            return
        try:
            spotify_volume(int(DUCKED.read_text()))
        except ValueError:
            pass
        DUCKED.unlink()


def speaking() -> bool:
    """Whether any session that is not holding speech has a live worker or queued text."""
    held = {p.name for p in HELD.glob("*")}
    for pidfile in PIDS.glob("*"):
        if pidfile.name in held:
            continue
        try:
            if is_chitchat(int(pidfile.read_text())):
                return True
        except (FileNotFoundError, ValueError):
            pass
    queued = [*QUEUES.glob("*/*.txt"), *QUEUES.glob("*/*.tmp")]
    return any(item.parent.name not in held for item in queued)


def spotify_volume(level: int | None = None) -> int | None:
    """Spotify's volume, after setting it to level if given. None when Spotify is
    not running, since asking it would launch it."""
    set_volume = f"set sound volume to {level}\n" if level is not None else ""
    script = (
        'if application "Spotify" is running then\n'
        f'tell application "Spotify"\n{set_volume}return sound volume\nend tell\n'
        "end if"
    )
    try:
        out = subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=10
        ).stdout.strip()
        return int(out)
    except (subprocess.TimeoutExpired, ValueError):
        return None


if __name__ == "__main__":
    main()
